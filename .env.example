# Copy to .env:  cp .env.example .env

# --- OpenRouter (free key: https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# Tried in order until one answers. Free model names change over time:
# see https://openrouter.ai/models?q=free
OPENROUTER_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free

# --- Database ---
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_DB=shop

# --- URLs ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
